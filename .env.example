# Copy to .env and edit. backend/.env is auto-loaded at startup (python-dotenv),
# so you no longer need to export these by hand. .env is git-ignored.

# Generic model when no custom weights are in models/ (auto-downloaded by ultralytics).
FALLBACK_MODEL=yolov8n.pt

# Industry-standard YOLO default is 0.25. The correct value for a given model is
# its F1-optimal confidence (peak of Ultralytics' F1_curve.png) — set that per
# model after you train your own weights.
CONF_THRESHOLD=0.25
XRAY_CONF_THRESHOLD=0.25
IOU_THRESHOLD=0.45
INFER_IMGSZ=640

# Keep consistent with how you trained (CLAHE on/off).
ENHANCE_CONTRAST=true

# Multi-class models: which class names count as caries (substring, case-insensitive).
# "lesion" is deliberately NOT here — the pretrained X-ray model's "Periapical
# lesion" class is not caries and caused false positives.
CARIES_CLASSES=caries,carie,cavity,decay

# ---- Chatbot LLM (any OpenAI-compatible endpoint) ----
# Groq (default, free tier — get a key at https://console.groq.com/keys):
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=gsk_your_free_groq_key_here
# Faster/cheaper Groq option: LLM_MODEL=openai/gpt-oss-20b
#
# Local Ollama instead (fully offline, no key):
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2:3b
#   LLM_API_KEY=            (leave empty)
